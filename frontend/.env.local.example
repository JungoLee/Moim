# 이 파일을 .env.local 로 복사.
# API 는 프론트와 같은 도메인(Workers)에서 서빙되므로 비워 둔다(상대경로).
# 분리 배포 등 예외 상황에서만 절대 URL 로 오버라이드.
NEXT_PUBLIC_API_URL=

# (선택) 사용자 노출 브랜드명 — 미설정 시 'Moim'
# NEXT_PUBLIC_BRAND_NAME=Moim

# (선택) 구글 애드센스 게시자 ID — 미설정 시 광고 비활성. 형식: ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
